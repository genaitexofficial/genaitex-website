# Copy to .env.local for local development. On Vercel, add these under Project -> Settings -> Environment Variables.

# Public site details (override the placeholders in lib/site.ts)
NEXT_PUBLIC_SITE_URL=https://genaitex.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@genaitex.com
# Digits only, with country code, e.g. 919876543210. Leave empty to hide WhatsApp links.
NEXT_PUBLIC_WHATSAPP=

# Contact form email delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Where inquiries are delivered
CONTACT_TO_EMAIL=
# Sender. Must be on a domain verified in Resend (onboarding@resend.dev only works for testing).
CONTACT_FROM_EMAIL=genaitex <hello@genaitex.com>
