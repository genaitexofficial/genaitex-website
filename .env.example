# Copy to .env.local for local development. On Vercel, add these under Project -> Settings -> Environment Variables.
# Every NEXT_PUBLIC_* value below already has the same default in lib/site.ts, so they are optional.

# Public site details
NEXT_PUBLIC_SITE_URL=https://genaitex.com
NEXT_PUBLIC_CONTACT_EMAIL=genaitexofficial@gmail.com
# Digits only, with country code (91 = India). An empty value hides WhatsApp links.
NEXT_PUBLIC_WHATSAPP=919912377803

# Contact form email delivery via Resend (https://resend.com). Required in production.
RESEND_API_KEY=
# Inbox that receives inquiries
CONTACT_TO_EMAIL=genaitexofficial@gmail.com
# Sender address.
#  - Until genaitex.com is verified in Resend: leave this unset (defaults to onboarding@resend.dev,
#    which only delivers to the email your Resend account was created with).
#  - After verifying genaitex.com in Resend: genaitex <hello@genaitex.com>
#  Gmail addresses cannot be used as the sender.
CONTACT_FROM_EMAIL=
